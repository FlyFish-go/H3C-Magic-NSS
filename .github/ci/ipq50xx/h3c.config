# Group "h3c": the H3C Magic family, all 256 MB IPQ5018/IPQ5000 boards.
# Same profiles as the 256m group: ath11k 256M + NSS LOW.
# HW-A = rc3000-v2, HW-B = rc3000-v1, HW-C = rc3000-v3, HW-D = nx30.
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-nx30=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v1=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v3=y

# Daily-use images, unlike the other groups' (which ship without LuCI):
# LuCI in Chinese with the Aurora theme, and the defaults of the H3C QSDK
# images (LAN 192.168.10.1, both Wi-Fi bands up with WPA2, country CN).
# Otherwise lean: apps that come from the official feeds are left for the
# user to install (UPnP, DDNS, WoL, ttyd, WireGuard and SQM pages, ...).
# Their kernel modules cannot come from there; they are built as packages
# below and published with the release (see h3c-magic-defaults).
CONFIG_PACKAGE_h3c-magic-defaults=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-nss=y
# port traffic from the hardware counters (interface statistics stop under NSS)
CONFIG_PACKAGE_luci-app-h3c-ports=y
# TUN devices for Tailscale, OpenVPN and the like
CONFIG_PACKAGE_kmod-tun=y
# compressed swap in RAM: 256 MB boards, and Go programs (AdGuard Home,
# Tailscale) that otherwise run the board out of memory
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_luci-proto-wireguard is not set
# CONFIG_PACKAGE_htop is not set

# Package repository of the release (with kmods-extra.config): more kernel
# modules and the toolchain libraries that only the target feed carries
CONFIG_PACKAGE_libstdcpp=m
CONFIG_PACKAGE_kmod-macvlan=m
CONFIG_PACKAGE_kmod-ipip=m
CONFIG_PACKAGE_kmod-sit=m
CONFIG_PACKAGE_kmod-ip6-tunnel=m
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=m
CONFIG_PACKAGE_kmod-nft-bridge=m
CONFIG_PACKAGE_kmod-nft-netdev=m
CONFIG_PACKAGE_kmod-nf-nathelper-extra=m
CONFIG_PACKAGE_kmod-sched=m
CONFIG_PACKAGE_kmod-veth=m

# full hostapd/wpa_supplicant: WPA3, 802.11r/k/v and 802.11s mesh, with this
# tree's hostapd patches (mesh peering after a radio firmware restart)
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq50xx_DEVICE_h3c_magic-nx30="-wpad-basic-mbedtls"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v1="-wpad-basic-mbedtls"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v2="-wpad-basic-mbedtls"
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq50xx_DEVICE_h3c_magic-rc3000-v3="-wpad-basic-mbedtls"
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# shown by LuCI (Status -> Overview, Firmware Version) and in /etc/openwrt_release
CONFIG_IMAGEOPT=y
CONFIG_VERSIONOPT=y
CONFIG_VERSION_CODE="H3C-Magic-NSS-v0.1.0-pre.5"
CONFIG_VERSION_HOME_URL="https://github.com/FlyFish-go/H3C-Magic-NSS"
CONFIG_VERSION_BUG_URL="https://github.com/FlyFish-go/H3C-Magic-NSS/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/FlyFish-go/H3C-Magic-NSS/issues"
# CONFIG_VERSION_FILENAMES is not set
# CONFIG_VERSION_CODE_FILENAMES is not set
CONFIG_PACKAGE_h3c-update=y
CONFIG_H3C_UPDATE_LINE="nss"
CONFIG_H3C_UPDATE_RELEASE="v0.1.0-pre.5"
CONFIG_PACKAGE_luci-app-h3c-update=y
CONFIG_PACKAGE_luci-i18n-h3c-update-zh-cn=y

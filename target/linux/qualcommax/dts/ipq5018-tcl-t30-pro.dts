/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"
#include "ipq5018-qcn6122.dtsi"
#include "ipq5018-nss.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/*
 * TCL T30 Pro, AP-MP02.1: WAN is switch port 4 of the QCA8337 on GMAC1
 * (SGMII), LAN1-LAN3 are switch ports 1-3. The stock device tree also has
 * the IPQ5018 GE PHY (MDIO address 7) on GMAC0, but what it is wired to is
 * not known: it is kept and declared as lan4 (not confirmed on hardware
 * whether a panel jack is connected to it).
 */

/ {
	model = "TCL T30 Pro";
	compatible = "tcl,t30-pro", "qcom,ipq5018";

	reserved-memory {
		q6_region_qcn6122_1: q6-region-qcn6122-1@4d200000 {
			reg = <0x0 0x4d200000 0x0 0xd00000>;
			no-map;
		};

		m3_dump_qcn6122_1: m3-dump-qcn6122-1@4df00000 {
			reg = <0x0 0x4df00000 0x0 0x100000>;
			no-map;
		};
	};

	aliases {
		serial0 = &blsp1_uart1;
		/*
		 * No label-mac-device: this board has no MAC address in the
		 * device tree at all. The stock MAC is the ASCII text at the
		 * start of the factory partition; board.d/02_network reads it
		 * and publishes the addresses (label MAC = WAN).
		 */
		led-boot = &led_green;
		led-failsafe = &led_red;
		led-running = &led_green;
		led-upgrade = &led_red;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=512K";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-reset {
			label = "reset";
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		button-wps {
			label = "wps";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_pins>;
		pinctrl-names = "default";

		led_green: led-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		};

		led_red: led-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&tlmm 23 GPIO_ACTIVE_HIGH>;
		};
	};
};

/* the stock TZ takes 4 MiB here (upstream reserves 2 MiB) */
&tz_region {
	reg = <0x0 0x4ac00000 0x0 0x400000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";

	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			/*
			 * The MAC addresses are not in ART on this board: the
			 * stock firmware keeps them as ASCII text at the start
			 * of the factory partition (read by 02_network), so ART
			 * only carries the calibration data.
			 */
			partition-0-art {
				label = "0:art";
				read-only;
			};
		};
	};
};

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

/* MAC0 -> IPQ5018 GE PHY (stock DTB: address 7), declared as lan4 */
&gmac0 {
	status = "okay";

	label = "lan4";
};

/* MAC1 ---SGMII---> QCA8337 port 6; no MAC from ART on this board */
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>, <&switch_reset_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;
	reset-delay-us = <10000>;
	reset-post-delay-us = <10000>;

	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	qca8337_3: ethernet-phy@3 {
		reg = <3>;
	};

	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-handle = <&qca8337_0>;
			};

			ethernet-port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan3";
				phy-handle = <&qca8337_2>;
			};

			ethernet-port@4 {
				reg = <4>;
				label = "wan";
				phy-handle = <&qca8337_3>;
			};

			/*
			 * CPU port 6 over SGMII: the QCA8337 has one SGMII lane
			 * that can serve MAC0 or MAC6, and our U-Boot runs the
			 * LAN of this board through MAC6.
			 */
			ethernet-port@6 {
				reg = <6>;
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};

&tlmm {
	button_pins: button-state {
		button-pins {
			pins = "gpio25", "gpio31";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_pins: led-state {
		pins = "gpio22", "gpio23";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	switch_reset_pins: switch-reset-state {
		pins = "gpio39";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		drive-strength = <8>;
		bias-disable;
	};

};

/*
 * QCN6122 on PCIe0 as user PD 2, reset on GPIO15 (as on the Cudy P5). The
 * stock boot-args put the radio on user PD 3 (<0x1 4 3 15 0 0>); following
 * the Cudy P5 is not confirmed on hardware yet.
 */
&q6v5_wcss {
	boot-args = <0x1 4 2 15 0 0>;
	status = "okay";
};

/* 256 MiB of RAM: low-memory firmware mode */
&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "TCL-T30-Pro";
	qcom,ath11k-fw-memory-mode = <2>;

	ieee80211-freq-limit = <2400000 2483000>;
};

&wifi1 {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,ath11k-calibration-variant = "TCL-T30-Pro";
	qcom,ath11k-fw-memory-mode = <2>;

	ieee80211-freq-limit = <5150000 5850000>;

	memory-region = <&q6_region_qcn6122_1>, <&q6_region_ipq5018>, <&m3_dump_qcn6122_1>;
	memory-region-names = "q6-region", "m3-region", "m3-dump";
};

/* 256 MiB of RAM: NSS heap 8 MiB, as in the stock reserved-memory */
&nss_region {
	reg = <0x0 0x40000000 0x0 0x800000>;
};

#!/bin/sh
#
# nss-dwmac-up loads ath11k after netifd has read /etc/config/wireless.
# On a fresh configuration the file has no radio then: 10-wifi-detect
# writes this phy's section as the phy appears and asks netifd to retry,
# which does not make netifd read the file again, so the radio stays
# unknown to netifd - and down, if the defaults enable it - until
# something reloads netifd. Reload it when it lacks this phy's radio.
# Runs per phy, so a radio that comes up later than the others is covered.

[ "$ACTION" = "add" ] || exit 0
[ -n "$DEVICENAME" ] || exit 0

# LuCI decides once per boot whether to show Network > Wireless (it needs a
# wifi-device in /etc/config/wireless) and caches the menu in
# /tmp/luci-indexcache.*.json. On a fresh configuration the radios are
# written here, some seconds after uhttpd is up, so a page loaded in
# between - even the login page - hid the menu until the next reboot
# (measured on HW-B: cache built at 30 s, radios written at 36 s).
# Drop the cache so the next request rebuilds it.
rm -f /tmp/luci-indexcache.*.json

# before netifd runs (a stock boot) it reads the file itself
ubus -S list network.wireless >/dev/null 2>&1 || exit 0

dev="$(readlink -f "/sys/class/ieee80211/$DEVICENAME/device")" || exit 0

for r in $(uci -q show wireless | sed -n 's/^wireless\.\([^.=]*\)=wifi-device$/\1/p'); do
	p="$(uci -q get "wireless.$r.path")"
	[ -n "$p" ] || continue
	case "$dev" in
	*/devices/"$p" | */devices/platform/"$p") ;;
	*) continue ;;
	esac
	if ! ubus call network.wireless status 2>/dev/null | jsonfilter -q -e "@.$r" >/dev/null; then
		logger -t nss-wifi "netifd has no $r ($DEVICENAME), written after it read the config - reloading netifd"
		ubus call network reload
	fi

	# Netifd knowing the radio does not mean a setup is coming: a late phy
	# (QCN9074 on PCIe, NX54) can have its retry land before its section
	# was read, or be dropped while another radio is being set up, and the
	# radio stays down. Wait in the background, so the hotplug queue
	# drains, until netifd is idle, then retry this one radio once if it
	# is still down. A radio that is up or disabled is left alone.
	(
		n=0
		while [ "$n" -lt 30 ]; do
			sleep 1
			n=$((n + 1))
			[ "$(uci -q get "wireless.$r")" = wifi-device ] || exit 0
			[ "$(uci -q get "wireless.$r.disabled")" = 1 ] && exit 0
			status="$(ubus call network.wireless status 2>/dev/null)" || continue
			[ "$(printf '%s\n' "$status" | jsonfilter -q -e "@.$r.up")" = true ] && exit 0
			[ "$(printf '%s\n' "$status" | jsonfilter -q -e "@.$r.disabled")" = true ] && exit 0
			[ "$(printf '%s\n' "$status" | jsonfilter -q -e "@.$r.pending")" = false ] || continue
			printf '%s\n' "$status" | jsonfilter -q -e '@[*].pending' | grep -q true && continue
			logger -t nss-wifi "$r ($DEVICENAME) is idle and down - retrying its setup"
			ubus call network.wireless retry "{\"device\":\"$r\"}" 2>/dev/null || true
			exit 0
		done
		logger -p user.warn -t nss-wifi "$r ($DEVICENAME) did not become idle within 30 s"
	) </dev/null >/dev/null 2>&1 &
	exit 0
done

exit 0

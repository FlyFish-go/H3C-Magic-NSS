#!/bin/sh
#
# Runs on the first boot of every new image, also after a keep-settings
# sysupgrade: only change what is still at its default.

. /lib/functions.sh

case "$(board_name)" in
h3c,magic-*) ;;
*) exit 0 ;;
esac

# LuCI's time zone list goes by the zone name; board.d can only set the
# POSIX string, and config_generate leaves the name at UTC
if [ "$(uci -q get system.@system[0].timezone)" = "CST-8" ] &&
   [ "$(uci -q get system.@system[0].zonename)" = "UTC" ]; then
	uci -q set system.@system[0].zonename='Asia/Shanghai'
	uci -q commit system
fi

# LuCI in Chinese, once: a language the user picks later stays
if [ -z "$(uci -q get luci.main.h3c_defaults)" ] && uci -q get luci.main >/dev/null; then
	[ "$(uci -q get luci.main.lang)" = "auto" ] && uci -q set luci.main.lang='zh_cn'
	uci -q set luci.main.h3c_defaults='1'
	uci -q commit luci
fi

# The generated feed list names the official target feed and an nss feed.
# Neither fits this image: the official kernel modules are built for
# another kernel (apk refuses them), and there is no official nss feed.
# Each release publishes the package repository of its own build instead:
# kernel modules, toolchain libraries (libstdcpp6, ...) and the packages of
# this tree, signed with the key in this image. Packages without kernel
# modules (LuCI apps, tools) still come from the official snapshot feeds.
feeds=/etc/apk/repositories.d/distfeeds.list
repo=
. /etc/openwrt_release
case "$DISTRIB_DESCRIPTION" in
*H3C-Magic-NSS-v[0-9]*)
	repo="https://flyfish-go.github.io/H3C-Magic-NSS/${DISTRIB_DESCRIPTION##*H3C-Magic-NSS-}/packages.adb"
	;;
esac
if [ -f "$feeds" ]; then
	sed -i -e '\#/packages/[^/]*/nss/#d' "$feeds"
	if [ -n "$repo" ]; then
		sed -i -e "s#^[^\#]*/targets/.*#$repo#" "$feeds"
	else
		sed -i -e '\#/targets/#d' "$feeds"
	fi
fi

exit 0
